generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  id         Int    @id @default(autoincrement())
  username   String @unique(map: "User_username_key")
  password   String
  first_name String
  last_name  String
  role       String @default("user")
}

model PatientVisit {
  id           String   @id @default(cuid())
  patientName  String
  age          Int
  gender       String
  visitDate    DateTime
  visitTime    String
  visitType    String
  diagnosis    String
  prescription String
  status       String
  notes        String
  allergies    String?
  bloodType    String?
  gp           String?
  createdAt    DateTime @default(now())
}