generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model user {
  id         Int    @id @default(autoincrement())
  username   String @unique(map: "User_username_key")
  password   String
  first_name String
  last_name  String
  role       String @default("user")
}

model PatientVisit {
  id           String   @id @default(cuid())
  patientId    Int?
  patientName  String
  age          Int
  gender       String
  visitDate    DateTime
  visitTime    String
  visitType    String
  diagnosis    String
  prescription String
  status       String
  notes        String
  allergies    String?
  bloodType    String?
  gp           String?
  createdAt    DateTime @default(now())
  patient      Patient? @relation(fields: [patientId], references: [id])
}

model Patient {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  age          Int
  gender       String
  contactPhone String?
  email        String?
  allergies    String?
  bloodType    String?
  gp           String?
  notes        String?
  createdAt    DateTime @default(now())
  visits       PatientVisit[]
  appointments Appointment[]
}

model Appointment {
  id              Int      @id @default(autoincrement())
  appointmentNumber String @unique
  patientId       Int?
  patientName     String
  contactPhone    String
  email           String?
  appointmentDate DateTime
  appointmentTime String
  reason          String?
  status          String   @default("scheduled")
  createdAt       DateTime @default(now())
  patient         Patient? @relation(fields: [patientId], references: [id])
}